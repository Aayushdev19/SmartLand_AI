# SmartLand AI — Frontend Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# URL of the FastAPI backend
VITE_API_URL=http://localhost:8000

# Google OAuth client ID for real Gmail/Google sign-in
# Create one in Google Cloud Console for a Web application and add http://localhost:5173 and http://127.0.0.1:5173 to Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# App display name (optional)
VITE_APP_NAME=SmartLand AI
